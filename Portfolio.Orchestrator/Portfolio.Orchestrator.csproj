    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>apphost-e39e007b27ea477dfdc2a9ae451d09769cbaea2709436630b62461add54062d8</UserSecretsId>
