[Unit]
Description=First issuance of the site certificate on this droplet (start by hand after placing /etc/portfolio/lego.env; inert once a cert exists)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/portfolio/lego.env
ConditionPathExists=!/var/lib/portfolio-lego/certificates/atmiller.org.crt

[Service]
Type=oneshot
EnvironmentFile=/etc/portfolio/lego.env
ExecStart=/usr/bin/lego --accept-tos --email ${LEGO_EMAIL} --dns porkbun --domains atmiller.org --domains www.atmiller.org --path /var/lib/portfolio-lego run --run-hook "systemctl start portfolio-certs-install.service"
