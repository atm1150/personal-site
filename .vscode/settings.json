{
  "rust-analyzer.linkedProjects": ["site/Cargo.toml"],

  // The `app` crate is compiled twice (server=ssr, wasm=hydrate) and its
  // default feature set is empty. Analyze the `ssr` view: that's where nearly
  // all code lives, and enabling both modes at once does not compile. The
  // wasm/hydrate build is still verified continuously by `cargo leptos watch`.
  "rust-analyzer.cargo.features": ["ssr"],

  // Keep rust-analyzer's on-save check out of `cargo leptos watch`'s target
  // directory so the two don't contend for the Cargo build lock.
  "rust-analyzer.cargo.targetDir": true,

  "rust-analyzer.check.command": "clippy",

  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  }
}
