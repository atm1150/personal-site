<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Audit direct dependencies only; transitive vulnerabilities belong to upstream packages. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pulumi" Version="3.112.0" />
    <PackageReference Include="Pulumi.DigitalOcean" Version="4.78.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Portfolio.Infra.Tests" />
  </ItemGroup>

</Project>
